begin;

alter table public.messages
    alter column content drop not null;

alter table public.messages
    add column if not exists type text not null default 'text';

alter table public.messages
    add column if not exists shared_activity_id uuid
        references public.activities(id)
        on delete cascade;

alter table public.messages
    add column if not exists shared_post_id uuid
        references public.activity_photos(id)
        on delete cascade;

do $$
begin
    if not exists (
        select 1 from pg_constraint where conname = 'messages_type_check'
    ) then
        alter table public.messages
            add constraint messages_type_check
            check (type in ('text', 'activity', 'post'));
    end if;
end
$$;

commit;
