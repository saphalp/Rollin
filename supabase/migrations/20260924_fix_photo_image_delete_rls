begin;

-- The previous "Post owner can delete images" policy checked ownership by
-- joining back to activity_photos. Deleting a post cascades into
-- activity_photo_images via an AFTER DELETE trigger, which fires once the
-- parent activity_photos row is already gone, so that join always came up
-- empty and RLS blocked the cascade. Denormalize user_id onto this table so
-- ownership can be checked without depending on the parent row.

alter table public.activity_photo_images
    add column if not exists user_id uuid
        references public.profiles(id)
        on delete cascade;

update public.activity_photo_images images
set user_id = post.user_id
from public.activity_photos post
where post.id = images.post_id
  and images.user_id is null;

alter table public.activity_photo_images
    alter column user_id set not null;

drop policy if exists "Post owner can add images"
on public.activity_photo_images;

drop policy if exists "Post owner can delete images"
on public.activity_photo_images;

create policy "Post owner can add images"
on public.activity_photo_images
for insert
to authenticated
with check (user_id = (select auth.uid()));

create policy "Post owner can delete images"
on public.activity_photo_images
for delete
to authenticated
using (user_id = (select auth.uid()));

commit;
